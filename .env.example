# Public web and API
FRONTEND_URL=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:4000/api
PORT=4000
NODE_ENV=development

# MongoDB Atlas: do not commit a real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/aurelia?retryWrites=true&w=majority
# Internal service authentication: generate separate 32+ character secrets.
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_SERVICE_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Firebase Authentication
# Download a Firebase Admin SDK service-account JSON key and keep it out of version control.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Copy these public values from Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
AI_SERVICE_URL=http://127.0.0.1:8000
FAST_MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MAX_UPLOAD_MB=10

# Optional interpretation provider. Deterministic calculations work without this.
FINWELL_AI_API_KEY=
FINWELL_AI_BASE_URL=https://
